# Backend Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Storage Path
STORAGE_PATH=/tmp/research_partner

# Default OpenAI Settings (can be overridden by users in the UI)
DEFAULT_API_BASE=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4-turbo-preview

# Security Notes:
# - Never commit API keys to version control
# - Users provide their own API keys through the UI
# - All dependencies are updated to patched versions
# - Run 'pip-audit' regularly to check for vulnerabilities
